Options -MultiViews -Indexes
DirectoryIndex index.php
RewriteEngine On

# Block direct web access to PHP includes. They hold config.php with the
# database credentials and are only ever loaded by PHP, never requested.
RewriteRule ^includes/ - [F,L]

# Force HTTPS. Enable this once the SSL certificate is active in Hostinger,
# otherwise visitors land on a certificate error.
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Combo detail pages use descriptive canonical paths.
RewriteCond %{QUERY_STRING} (^|&)boxes=3(&|$) [NC]
RewriteCond %{REQUEST_URI} ^(.*/)combo-detail(?:\.php)?/?$ [NC]
RewriteRule ^combo-detail(?:\.php)?/?$ %1combo/starter [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)boxes=6(&|$) [NC]
RewriteCond %{REQUEST_URI} ^(.*/)combo-detail(?:\.php)?/?$ [NC]
RewriteRule ^combo-detail(?:\.php)?/?$ %1combo/popular [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)boxes=9(&|$) [NC]
RewriteCond %{REQUEST_URI} ^(.*/)combo-detail(?:\.php)?/?$ [NC]
RewriteRule ^combo-detail(?:\.php)?/?$ %1combo/value [R=301,L,QSD]
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{REQUEST_URI} ^(.*/)combo-detail(?:\.php)?/?$ [NC]
RewriteRule ^combo-detail(?:\.php)?/?$ %1combo/starter [R=301,L,QSD]
RewriteCond %{REQUEST_URI} ^(.*/)combo/(?:starter|popular|value)/$
RewriteRule ^combo/(starter|popular|value)/$ %1combo/$1 [R=301,L]
RewriteRule ^combo/starter$ combo-detail.php?boxes=3 [END]
RewriteRule ^combo/popular$ combo-detail.php?boxes=6 [END]
RewriteRule ^combo/value$ combo-detail.php?boxes=9 [END]

# Canonical public URLs never expose the PHP implementation.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[?\s] [NC]
RewriteRule ^index\.php$ ./ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[?\s] [NC]
RewriteRule ^(.+)\.php$ $1 [R=301,L,NE]

# Serve an extensionless request from its matching PHP file. Existing files,
# directories and assets remain untouched.
RewriteRule ^product/([a-z0-9-]+)/?$ product.php?product=$1 [END,QSA,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [END,QSA]